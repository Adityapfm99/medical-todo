{
  "compilerOptions": {
    "resolveJsonModule": true, // Enable importing JSON modules
    "esModuleInterop": true,  // Ensure compatibility with ES modules
    "strict": true,           // TypeScript strict mode
    "module": "commonjs",     // Use commonjs for compatibility
    "typeRoots": ["./node_modules/@types", "./src/types"],
    "target": "ES2020",
    "outDir": "./dist",
    "rootDir": "./src",
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules"]
}

